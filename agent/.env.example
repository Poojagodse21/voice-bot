# LiveKit server (local dev values; change for Oracle deployment)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Get this from https://aistudio.google.com -> Get API key
GOOGLE_API_KEY=your-gemini-api-key

# Optional
GEMINI_MODEL=gemini-3.8-live
GEMINI_VOICE=Puck

# How long you must be silent before the bot decides you finished talking.
# Lower = faster replies, but more chance it cuts you off mid-pause.
VAD_SILENCE_MS=500
